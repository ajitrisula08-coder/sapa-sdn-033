# Salin file ini menjadi ".env.local" lalu isi dengan data dari Supabase:
# Supabase Dashboard > Project Settings > API
# HANYA isi "Project URL" dan kunci "anon public".
# JANGAN PERNAH mengisi "service_role key" di sini — kunci itu rahasia.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-public-key
